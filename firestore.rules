rules_version = '2';

service cloud.firestore {
	match /databases/{database}/documents {
		match /orders/{orderId} {
			allow create: if request.resource.data.keys().hasAll([
					'firstName', 'lastName', 'phone', 'item', 'quantity',
					'unitPrice', 'total', 'consent', 'createdAt'
				])
				&& request.resource.data.keys().hasOnly([
					'firstName', 'lastName', 'phone', 'item', 'quantity',
					'unitPrice', 'total', 'consent', 'createdAt'
				])
				&& request.resource.data.firstName is string
				&& request.resource.data.firstName.size() > 0
				&& request.resource.data.firstName.size() <= 80
				&& request.resource.data.lastName is string
				&& request.resource.data.lastName.size() > 0
				&& request.resource.data.lastName.size() <= 80
				&& request.resource.data.phone is string
				&& request.resource.data.phone.size() >= 6
				&& request.resource.data.phone.size() <= 25
				&& request.resource.data.item in [
					'console game M15',
					'trépied C12',
					'sachet de serviettes hygiéniques compressées'
				]
				&& request.resource.data.quantity is int
				&& request.resource.data.quantity >= 1
				&& request.resource.data.quantity <= 100
				&& request.resource.data.unitPrice is int
				&& (
					(request.resource.data.item == 'console game M15' && request.resource.data.unitPrice == 15000)
					|| (request.resource.data.item == 'trépied C12' && request.resource.data.unitPrice == 10000)
					|| (
						request.resource.data.item == 'sachet de serviettes hygiéniques compressées'
						&& request.resource.data.unitPrice == 200
					)
				)
				&& request.resource.data.total == request.resource.data.quantity * request.resource.data.unitPrice
				&& request.resource.data.consent == true
				&& request.resource.data.createdAt == request.time;

			allow read, delete: if request.auth != null
				&& request.auth.uid == 'CNusVmq4PsMC59DVuUzzmqf8aE02';
		}
	}
}
